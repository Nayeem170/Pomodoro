{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GateResult",
  "type": "object",
  "required": ["gate", "description", "command", "status", "startedAt", "completedAt"],
  "properties": {
    "gate": {
      "type": "string",
      "pattern": "^gate[0-9]+\\.\\w+$",
      "description": "Gate identifier, e.g. gate2.format, gate3.build, gate4.test"
    },
    "description": { "type": "string" },
    "command": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "passed", "failed", "timeout", "skipped"]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "exitCode": {
      "type": ["integer", "null"],
      "description": "Process exit code. Null if timeout or still running."
    },
    "stdout": {
      "type": ["string", "null"],
      "description": "Last 2000 chars of stdout"
    },
    "stderr": {
      "type": ["string", "null"],
      "description": "Last 2000 chars of stderr"
    }
  },
  "additionalProperties": false
}
