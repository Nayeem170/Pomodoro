@page "/"
@inherits IndexBase

@if (IsLoading)
{
    <div class="loading-container" role="status" aria-label="Loading">
        <div class="loading-spinner">
            <svg viewBox="0 0 192 192" width="100%" height="100%" fill="none" aria-hidden="true">
                <mask id="ls-gap-app">
                    <rect width="192" height="192" fill="#fff"/>
                    <path d="M96,96 L154.1,29.8" stroke="#000" stroke-width="28" stroke-linecap="round"/>
                </mask>
                <g class="ls-minute">
                    <circle cx="96" cy="96" r="74" stroke="var(--long-break-color)" stroke-width="14" mask="url(#ls-gap-app)"/>
                    <path d="M96,96 L154.1,29.8" stroke="var(--pomodoro-color)" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
                <path class="ls-hour" d="M66.9,68.6 L96,96" stroke="var(--short-break-color)" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </div>
}
else
{
    <div class="main-container">
        <div class="timer-split @(IsScheduleView ? "schedule-view" : "")">
            <div class="split-timer">
                <div class="timer-pane-summary desktop-only">
                    <div class="summary-cell">
                        <span class="summary-val">@FormatFocusMinutes(TodayTotalFocusMinutes)</span>
                        <span class="summary-lbl">Focused</span>
                    </div>
                    <div class="summary-cell">
                        <span class="summary-val">@TodayPomodoroCount/@DailyGoal</span>
                        <span class="summary-lbl">Pomodoros</span>
                    </div>
                    <div class="summary-cell">
                        <span class="summary-val">@TodayTasksWorkedOn</span>
                        <span class="summary-lbl">Tasks</span>
                    </div>
                    <div class="summary-cell">
                        <span class="summary-val">@(IsTimerRunning ? DateTime.Now.AddSeconds(RemainingTime.TotalSeconds).ToString("h:mm") : "--")</span>
                        <span class="summary-lbl">Ends at</span>
                    </div>
                </div>

                <div class="mode-tabs" role="tablist">
                    <button class="@(CurrentSessionType == SessionType.Pomodoro ? "active pomodoro-active" : "")"
                            @onclick="() => HandleSessionSwitch(SessionType.Pomodoro)"
                            title="@Constants.KeyboardShortcuts.PomodoroKey"
                            role="tab"
                            aria-selected="@(CurrentSessionType == SessionType.Pomodoro)">
                        Pomodoro
                    </button>
                    <button class="@(CurrentSessionType == SessionType.ShortBreak ? "active short-break-active" : "")"
                            @onclick="() => HandleSessionSwitch(SessionType.ShortBreak)"
                            title="@Constants.KeyboardShortcuts.ShortBreakKey"
                            role="tab"
                            aria-selected="@(CurrentSessionType == SessionType.ShortBreak)">
                        Short break
                    </button>
                    <button class="@(CurrentSessionType == SessionType.LongBreak ? "active long-break-active" : "")"
                            @onclick="() => HandleSessionSwitch(SessionType.LongBreak)"
                            title="@Constants.KeyboardShortcuts.LongBreakKey"
                            role="tab"
                            aria-selected="@(CurrentSessionType == SessionType.LongBreak)">
                        Long break
                    </button>
                </div>

                <div class="timer-card desktop-only @GetTimerThemeClass() @(IsTimerRunning ? "running" : "")">
                    <div class="card-top">
                        <TimerDisplay RemainingTime="RemainingTime"
                                      SessionType="CurrentSessionType"
                                      IsRunning="IsTimerRunning"
                                      CurrentTaskName="@GetCurrentTaskName()" />

                        @if (CurrentSessionType == SessionType.Pomodoro)
                        {
                            <div class="timer-task-pill">
                                <span class="timer-task-dot"></span>
                                <span class="timer-task-text">@(string.IsNullOrEmpty(GetCurrentTaskName()) ? Constants.TaskUI.SelectTaskPrompt : GetCurrentTaskName())</span>
                            </div>
                        }

                        <TimerControls IsRunning="IsTimerRunning"
                                       IsPaused="IsTimerPaused"
                                       IsStarted="IsTimerStarted"
                                       CanStart="CurrentTaskId.HasValue || CurrentSessionType != SessionType.Pomodoro"
                                       SessionType="CurrentSessionType"
                                       OnStart="HandleTimerStart"
                                       OnPause="HandleTimerPause"
                                       OnResume="HandleTimerResume"
                                       OnReset="HandleTimerReset">
                            <TrailingAction>
                                <button class="ibtn" @onclick="HandleTogglePip" title="@(IsPipOpen ? Constants.PipTimerUI.CloseFloatingTimerTitle : Constants.PipTimerUI.PopOutFloatingTimerTitle)" aria-label="Picture in Picture">
                                    <svg width="17" height="17" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.2"/><rect x="7" y="7" width="5.5" height="4.5" rx="1" fill="currentColor"/></svg>
                                </button>
                            </TrailingAction>
                        </TimerControls>
                    </div>
                    <div class="card-footer @(IsTimerRunning ? "" : "idle")">
                        <div class="ends-at">@(IsTimerRunning ? $"ENDS AT {DateTime.Now.AddSeconds(RemainingTime.TotalSeconds).ToString("h:mm tt")}" : "--")</div>
                        <div class="session-dots" role="img" aria-label="@TodayPomodoroCount of @DailyGoal pomodoros completed">
                            @for (var i = 0; i < DailyGoal; i++)
                            {
                                var dotClass = i < TodayPomodoroCount ? "sd filled" : (i == TodayPomodoroCount && IsTimerRunning ? "sd current" : "sd");
                                <span class="@dotClass"></span>
                            }
                        </div>
                    </div>
                </div>

                <div class="session-log-wrap desktop-only">
                    <SessionLog Sessions="TodayPomodoroSessions" />
                </div>
            </div>

            <div class="split-tasks">
                <StickyTimerBar SessionType="CurrentSessionType"
                                IsRunning="IsTimerRunning"
                                IsStarted="IsTimerStarted"
                                CurrentTaskName="@GetCurrentTaskName()"
                                CanStart="CurrentTaskId.HasValue || CurrentSessionType != SessionType.Pomodoro"
                                OnStart="HandleTimerStart"
                                OnPause="HandleTimerPause"
                                OnResume="HandleTimerResume"
                                OnSessionChange="HandleSessionSwitch" />
                <ErrorBoundary @ref="_tasksErrorBoundary">
                    <ChildContent>
                        <div class="tasks-section task-pane-card">
                            <TaskListTabs Lists="TabLists"
                                          CurrentListId="@ActiveListId"
                                          ServiceCurrentListId="@TaskService.CurrentListId"
                                          OnTabChanged="HandleTabChange" />
                            @if (IsScheduleView)
                            {
                                <ScheduleAgenda Days="ScheduleWindow"
                                                WindowLabel="@ScheduleWindowLabel"
                                                CanGoPrev="@(_scheduleWeekOffset > 0)"
                                                OnPrev="HandleSchedulePrev"
                                                OnNext="HandleScheduleNext"
                                                OnEditTask="HandleScheduleEdit"
                                                OnAddSubtask="HandleAddSubtask"
                                                OnComplete="HandleTaskComplete"
                                                OnDelete="HandleTaskDelete"
                                                OnUncomplete="HandleTaskUncomplete"
                                                OnReparentToRoot="HandleReparentToRoot"
                                                OnDemote="HandleDemote"
                                                OnToggleFollowParent="HandleToggleFollowParent"
                                                AllTasks="AppState.Tasks"
                                                GoogleLists="GoogleLists" />
                            }
                            else
                            {
                                <TaskList Tasks="TodayTasks.ToList()"
                                          CurrentTaskId="CurrentTaskId"
                                          GoogleLists="GoogleLists"
                                          ActiveListId="@ActiveListId"
                                          OnTaskAdd="HandleTaskAdd"
                                          OnTaskSelect="HandleTaskSelect"
                                          OnTaskComplete="HandleTaskComplete"
                                          OnTaskDelete="HandleTaskDelete"
                                          OnTaskUncomplete="HandleTaskUncomplete"
                                          OnTaskEdit="HandleTaskEdit"
                                          OnAddSubtask="HandleAddSubtask"
                                          OnReparentToRoot="HandleReparentToRoot"
                                          OnDemote="HandleDemote"
                                          OnToggleFollowParent="HandleToggleFollowParent" />
                            }
                        </div>
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="section-error" role="alert">
                            <p>Tasks failed to load.</p>
                            <button class="btn-icon-small btn-cancel" @onclick="() => _tasksErrorBoundary?.Recover()">Retry</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>

        <ConsentModal IsVisible="IsConsentModalVisible"
                      CompletedSessionType="ConsentService.CompletedSessionType"
                      CountdownSeconds="ConsentCountdown"
                      Options="ConsentOptions"
                      OnOptionSelected="HandleConsentOptionSelect" />

        @if (_undoToastVisible && _undoTaskName is not null)
        {
            <div class="undo-toast" role="status" aria-live="polite">
                <span class="undo-toast-msg">Deleted "@_undoTaskName"</span>
                <button class="undo-toast-btn" @onclick="HandleUndoDelete">Undo</button>
            </div>
        }

        @if (_errorToastVisible && _errorToastMessage is not null)
        {
            <div class="error-toast" role="alert" aria-live="assertive">
                <span class="error-toast-msg">@_errorToastMessage</span>
            </div>
        }

    </div>
}

@code {
    private ErrorBoundary? _tasksErrorBoundary;
}
