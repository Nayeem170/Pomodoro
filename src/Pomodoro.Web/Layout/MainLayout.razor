@inherits MainLayoutBase
@using Pomodoro.Web.Components
@inject LayoutPresenterService LayoutPresenter

<div class="app-wrapper">
    <header class="app-header">
        <div class="header-content-wrapper">
            <div class="header-left">
                <div class="header-title">
                    <span class="header-icon">@Constants.Layout.AppIcon</span>
                    <span class="header-text">@Constants.Layout.AppTitle</span>
                </div>
            </div>
            <nav class="header-nav desktop-nav">
                @foreach (var navLink in LayoutPresenter.GetNavigationLinks())
                {
                    <NavLink @key="navLink.Href" href="@navLink.Href" Match="@navLink.Match" title="@navLink.Title">
                        <span class="nav-icon">@navLink.Icon</span>
                        @navLink.Title
                    </NavLink>
                }
            </nav>
            <button class="header-action" @onclick="ShowKeyboardHelp" title="@Constants.KeyboardShortcuts.HelpKey" aria-label="Keyboard shortcuts">
                <svg width="14" height="14" viewBox="0 0 13 13" fill="none"><rect x="1" y="2.5" width="11" height="8" rx="1.5" stroke="currentColor" stroke-width="1.1"/><rect x="3" y="4.5" width="2" height="1.5" rx=".4" fill="currentColor"/><rect x="5.5" y="4.5" width="2" height="1.5" rx=".4" fill="currentColor"/><rect x="8" y="4.5" width="2" height="1.5" rx=".4" fill="currentColor"/><rect x="4" y="7" width="5" height="1.5" rx=".4" fill="currentColor"/></svg>
            </button>
        </div>
    </header>
    
    <main class="app-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <ErrorDisplay Exception="exception" OnRetry="RecoverError" />
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <KeyboardHelpModal IsVisible="IsKeyboardHelpVisible"
                       OnClose="HideKeyboardHelp" />

    <nav class="mobile-nav">
        @foreach (var navLink in LayoutPresenter.GetNavigationLinks())
        {
            <NavLink class="mobile-tab" @key="navLink.Href" href="@navLink.Href" Match="@navLink.Match">
                <span class="mobile-tab-icon">@navLink.Icon</span>
                <span class="mobile-tab-label">@navLink.Title</span>
            </NavLink>
        }
    </nav>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    public void RecoverError()
    {
        _errorBoundary?.Recover();
    }
}
