@inherits TaskItemBase
@using Pomodoro.Web.Models

<div class="task-row @GetTaskClass()" @ref="_rowElement" draggable="@(CanDrag ? "true" : "false")" @onclick="HandleSelect" role="button" tabindex="0" aria-level="@(Depth + 1)" @onkeydown="HandleKeyDown" @ondragstart="HandleDragStart" @ondragend="HandleDragEnd">
    @if (IsDragActive && IsReorderable && (DraggedTaskId.HasValue && DraggedTaskId.Value != Item.Id))
    {
        <div class="drop-zone top" aria-hidden="true"
             @ondragover="() => HandleZoneDragOver(true)" @ondragover:preventDefault
             @ondragleave="HandleZoneDragLeave"
             @ondrop="() => HandleZoneDrop(true)" @ondrop:preventDefault></div>
        <div class="drop-zone bot" aria-hidden="true"
             @ondragover="() => HandleZoneDragOver(false)" @ondragover:preventDefault
             @ondragleave="HandleZoneDragLeave"
             @ondrop="() => HandleZoneDrop(false)" @ondrop:preventDefault></div>
    }
    @if (IsDragActive && !IsReorderable)
    {
        <div class="no-drop-zone" aria-hidden="true"
             @ondragover="() => _noDropHover = true"
             @ondragleave="() => _noDropHover = false"></div>
    }
    @if (Depth > 0)
    {
        <span class="task-indent" aria-hidden="true" style="width:@(Depth * 20)px"></span>
    }
    @if (HasChildren)
    {
        <button class="row-toggle @(IsCollapsed ? "collapsed" : "")" @onclick="HandleToggleCollapse" @onclick:stopPropagation="true" aria-label="@(IsCollapsed ? "Expand" : "Collapse")">
            <svg width="12" height="12" viewBox="0 0 10 10"><path d="M3 1.5l4 3.5-4 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    }
    else
    {
        <span class="collapse-spacer" aria-hidden="true"></span>
    }
    @if (Item.IsCompleted)
    {
        <button class="task-checkbox completed" @onclick="HandleUncomplete" @onclick:stopPropagation="true" aria-label="Undo">
            <svg width="11" height="11" viewBox="0 0 11 11"><polyline points="1.5,5.5 4,8 9.5,2.5" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    }
    else
    {
        <button class="task-checkbox" @onclick="HandleComplete" @onclick:stopPropagation="true" aria-label="Complete"></button>
    }
    @if (IsInlineEditing)
    {
        <textarea class="task-text-input"
               rows="1"
               value="@InlineEditName"
               @oninput="@((ChangeEventArgs e) => InlineEditName = e.Value?.ToString() ?? string.Empty)"
               @onblur="SaveInlineEdit"
               @onkeydown="HandleInlineEditKey"
               @onclick:stopPropagation="true"
               @ondblclick:stopPropagation="true"
               aria-label="Edit task name"
               @ref="_inlineEditInput"></textarea>
    }
    else
    {
        <span class="task-text @(Item.IsCompleted ? "completed" : "")" @ondblclick="StartInlineEdit">@Item.Name</span>
    }
    <div class="task-secondary">
        @if (Item.IsRecurring)
        {
            <span class="task-badge repeat-badge" title="@GetRepeatTooltip()">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5V4a1.5 1.5 0 0 1 1.5-1.5H10"/><polyline points="8.5,1 10,2.5 8.5,4"/><path d="M10 7v1a1.5 1.5 0 0 1-1.5 1.5H2"/><polyline points="3.5,11 2,9.5 3.5,8"/></svg>
                <span class="badge-label">@RepeatLabelText</span>
            </span>
        }
        @if (Item.ScheduledDate.HasValue)
        {
            <span class="task-badge schedule-badge" title="Scheduled for @Item.ScheduledDate.Value.ToString("MMM d")">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="2.5" width="9" height="8" rx="1.5"/><path d="M1.5 5h9"/><path d="M4 1.5v2M8 1.5v2"/></svg>
                <span class="badge-label">@Item.ScheduledDate.Value.ToString("MMM d")</span>
            </span>
        }
        @if (Item.Repeat?.IsPaused == true)
        {
            <span class="task-badge paused-badge" title="Repeat paused">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor"><rect x="3" y="2" width="2.5" height="8" rx="0.75"/><rect x="6.5" y="2" width="2.5" height="8" rx="0.75"/></svg>
            </span>
        }
        @if (Item.IsGoogleTask)
        {
            <span class="task-badge google-badge" title="@GoogleBadgeTooltip" aria-label="@GoogleBadgeTooltip" role="img">
                <svg width="11" height="11" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            </span>
        }
        <div class="task-actions">
            @if (!Item.IsCompleted)
            {
                @if (Depth > 0)
                {
                    <button class="task-action-btn follow-parent @(Item.FollowsParentRepeat ? "active" : "inactive")" @onclick="HandleToggleFollowParent" @onclick:stopPropagation="true" title="@(Item.FollowsParentRepeat ? "Following parent repeat - click to make one-time" : "One-time task - click to follow parent repeat")" aria-label="Toggle follow parent repeat">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5V4a1.5 1.5 0 0 1 1.5-1.5H10"/><polyline points="8.5,1 10,2.5 8.5,4"/><path d="M10 7v1a1.5 1.5 0 0 1-1.5 1.5H2"/><polyline points="3.5,11 2,9.5 3.5,8"/></svg>
                    </button>
                }
                @if (CanAddSubtask)
                {
                    <button class="task-action-btn" @onclick="StartAddSubtask" @onclick:stopPropagation="true" title="Add subtask" aria-label="Add subtask">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                }
                @if (CanDemote)
                {
                    <button class="task-action-btn" @onclick="HandleDemote" @onclick:stopPropagation="true" title="Demote" aria-label="Demote">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                }
                @if (CanMoveToRoot)
                {
                    <button class="task-action-btn" @onclick="HandleReparentToRoot" @onclick:stopPropagation="true" title="Promote" aria-label="Promote">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                }
                <button class="task-action-btn" @onclick="HandleEdit" @onclick:stopPropagation="true" title="Edit" aria-label="Edit task">
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M8.5 1.5l2 2L4 10H2V8l6.5-6.5z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            }
            <button class="task-action-btn delete" @onclick="HandleDelete" @onclick:stopPropagation="true" title="Delete" aria-label="Delete">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
        </div>
    </div>
    <span class="task-pomo-count">@FormatTime(Item.TotalFocusMinutes)</span>
</div>
@if (IsEditing)
{
    <TaskEditPanel Task="Item" ContextDate="ContextDate" OnSave="HandleEditSave" OnCancel="HandleEditCancel" />
}
@if (IsDemoteMenuOpen)
{
    <div class="demote-picker" style="margin-left:@((Depth + 1) * 20)px">
        <span class="demote-picker-label">Demote under:</span>
        @foreach (var sibling in Siblings)
        {
            var sibId = sibling.Id;
            <button class="demote-pick" @onclick="() => ConfirmDemote(sibId)" @onclick:stopPropagation="true" title="Demote under @sibling.Name">@sibling.Name</button>
        }
        <button class="demote-pick-cancel" @onclick="CancelDemote" @onclick:stopPropagation="true">Cancel</button>
    </div>
}
@if (IsAddingSubtask)
{
    <div class="add-subtask-form" style="margin-left:@((Depth + 1) * 20)px">
        <textarea rows="1"
               @bind="NewSubtaskName"
               @bind:event="oninput"
               @onkeydown="HandleSubtaskKeyPress"
               placeholder="Subtask name..."
               class="task-input"
               aria-label="New subtask name"></textarea>
        <button class="btn-icon-small btn-add" @onclick="HandleAddSubtask" disabled="@IsAddSubtaskDisabled" title="Add" aria-label="Add">
            +
        </button>
        <button class="btn-icon-small btn-cancel" @onclick="CancelAddSubtask" title="Cancel" aria-label="Cancel">
            x
        </button>
    </div>
}
@if (IsConfirmingDelete)
{
    <div class="delete-confirm" style="margin-left:@(Depth * 20)px">
        <div class="delete-confirm-title">Delete task and its subtasks?</div>
        <div class="delete-confirm-body">"@Item.Name" has @(ChildCount) subtask@(ChildCount == 1 ? "" : "s"). They are deleted with it. You can undo this.</div>
        <div class="delete-confirm-actions">
            <button class="delete-confirm-cancel" @onclick="CancelDelete">Cancel</button>
            <button class="delete-confirm-go" @onclick="ConfirmDelete">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                Delete all
            </button>
        </div>
    </div>
}
