@inherits TaskEditPanelBase
@using Pomodoro.Web.Models

<div class="task-edit-panel">
    <div class="tep-header">
        <span class="tep-title">EDITING TASK</span>
        <button type="button" class="tep-collapse" @onclick="HandleCancel" aria-label="Close edit panel">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 7.5l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>
    <div class="tep-row">
        <label class="tep-label">Name</label>
        <textarea class="tep-input tep-input-name" rows="1" @bind="EditName" @bind:event="oninput"
                  @onkeydown="HandleNameKey" aria-label="Task name" autofocus="@IsSubtask" @ref="_subtaskInput"></textarea>
    </div>

    <div class="tep-row">
        <label class="tep-label">Repeat</label>
        <select class="tep-select" @bind="EditRepeatChoice" @bind:event="onchange" aria-label="Repeat type">
            @if (IsSubtask)
            {
                <option value="@Constants.Repeat.FollowParentChoice">Follow parent</option>
            }
            <option value="@RepeatType.None">None</option>
            <option value="@RepeatType.Daily">Daily</option>
            <option value="@RepeatType.Weekly">Weekly</option>
            <option value="@RepeatType.Custom">Every N days</option>
            <option value="@RepeatType.Monthly">Monthly</option>
            <option value="@RepeatType.Quarterly">Quarterly</option>
            <option value="@RepeatType.Yearly">Yearly</option>
        </select>
    </div>

    @if (EditRepeatType == RepeatType.Weekly && !EditFollowParent)
    {
        <div class="tep-row tep-weekdays">
            <label class="tep-label">Days</label>
            <div class="tep-weekday-btns">
                @foreach (var day in WeekdayOptions)
                {
                    var isSelected = EditWeekdays.Contains(day);
                    <button type="button"
                            class="tep-weekday-btn @(isSelected ? "active" : "")"
                            @onclick="() => ToggleWeekday(day)">
                        @day.ToString().Substring(0, 2)
                    </button>
                }
            </div>
        </div>
    }

    @if (EditRepeatType == RepeatType.Custom && !EditFollowParent)
    {
        <div class="tep-row">
            <label class="tep-label">Every</label>
            <input type="number" class="tep-input tep-input-sm" min="1" max="@Constants.Repeat.MaxCustomDays"
                   @bind="EditCustomDays" @bind:event="oninput" />
            <span class="tep-unit">days</span>
        </div>
    }

    @if (EditRepeatType == RepeatType.Monthly && !EditFollowParent)
    {
        <div class="tep-row">
            <label class="tep-label">By</label>
            <select class="tep-select" @bind="EditRepeatBy" @bind:event="onchange" aria-label="Repeat by">
                <option value="false">@Constants.Repeat.ModeDayOfMonth</option>
                <option value="true">@Constants.Repeat.ModeDayOfWeek</option>
            </select>
        </div>
        @if (EditRepeatBy == "false")
        {
            <div class="tep-row">
                <label class="tep-label">Day</label>
                <input type="number" class="tep-input tep-input-sm" min="1" max="31"
                       @bind="EditMonthlyDay" @bind:event="oninput" />
                <span class="tep-unit">of month</span>
            </div>
        }
        else
        {
            <div class="tep-row">
                <label class="tep-label">Week</label>
                <select class="tep-select" aria-label="Week of month" @bind="EditWeekOfMonth">
                    @for (var i = 1; i <= Constants.Repeat.WeekOfMonthLabels.Length; i++)
                    {
                        <option value="@i">@Constants.Repeat.WeekOfMonthLabels[i - 1]</option>
                    }
                </select>
            </div>
            <div class="tep-row tep-weekdays">
                <label class="tep-label">Days</label>
                <div class="tep-weekday-btns">
                    @foreach (var day in WeekdayOptions)
                    {
                        var isSelected = EditWeekdays.Contains(day);
                        <button type="button"
                                class="tep-weekday-btn @(isSelected ? "active" : "")"
                                @onclick="() => ToggleWeekday(day)">
                            @day.ToString().Substring(0, 2)
                        </button>
                    }
                </div>
            </div>
        }
    }

    @if (EditRepeatType == RepeatType.Quarterly && !EditFollowParent)
    {
        <div class="tep-row">
            <label class="tep-label">Months</label>
            <select class="tep-select" aria-label="Quarterly months" @bind="EditQuarterlyMonth">
                @for (var i = 1; i <= Constants.Repeat.QuarterlyGroupLabels.Length; i++)
                {
                    <option value="@i">@Constants.Repeat.QuarterlyGroupLabels[i - 1]</option>
                }
            </select>
        </div>
        <div class="tep-row">
            <label class="tep-label">By</label>
            <select class="tep-select" @bind="EditRepeatBy" @bind:event="onchange" aria-label="Repeat by">
                <option value="false">@Constants.Repeat.ModeDayOfMonth</option>
                <option value="true">@Constants.Repeat.ModeDayOfWeek</option>
            </select>
        </div>
        @if (EditRepeatBy == "false")
        {
            <div class="tep-row">
                <label class="tep-label">Day</label>
                <input type="number" class="tep-input tep-input-sm" min="1" max="31"
                       @bind="EditQuarterlyDay" @bind:event="oninput" />
                <span class="tep-unit">of month</span>
            </div>
            @if (EditQuarterlyDay > 28)
            {
                <div class="tep-hint">@Constants.Repeat.MonthEndClampHint</div>
            }
        }
        else
        {
            <div class="tep-row">
                <label class="tep-label">Week</label>
                <select class="tep-select" aria-label="Week of month" @bind="EditWeekOfMonth">
                    @for (var i = 1; i <= Constants.Repeat.WeekOfMonthLabels.Length; i++)
                    {
                        <option value="@i">@Constants.Repeat.WeekOfMonthLabels[i - 1]</option>
                    }
                </select>
            </div>
            <div class="tep-row tep-weekdays">
                <label class="tep-label">Days</label>
                <div class="tep-weekday-btns">
                    @foreach (var day in WeekdayOptions)
                    {
                        var isSelected = EditWeekdays.Contains(day);
                        <button type="button"
                                class="tep-weekday-btn @(isSelected ? "active" : "")"
                                @onclick="() => ToggleWeekday(day)">
                            @day.ToString().Substring(0, 2)
                        </button>
                    }
                </div>
            </div>
        }
    }

    @if (EditRepeatType == RepeatType.Yearly && !EditFollowParent)
    {
        <div class="tep-row">
            <label class="tep-label">Month</label>
            <select class="tep-select" aria-label="Yearly month" @bind="EditYearlyMonth" @bind:after="ClampEditYearlyDay">
                @for (var i = 1; i <= Constants.Repeat.MonthNames.Length; i++)
                {
                    <option value="@i">@Constants.Repeat.MonthNames[i - 1]</option>
                }
            </select>
        </div>
        <div class="tep-row">
            <label class="tep-label">By</label>
            <select class="tep-select" @bind="EditRepeatBy" @bind:event="onchange" aria-label="Repeat by">
                <option value="false">@Constants.Repeat.ModeDayOfMonth</option>
                <option value="true">@Constants.Repeat.ModeDayOfWeek</option>
            </select>
        </div>
        @if (EditRepeatBy == "false")
        {
            <div class="tep-row">
                <label class="tep-label">Day</label>
                <select class="tep-select" aria-label="Yearly day" @bind="EditYearlyDay">
                    @for (var i = 1; i <= RepeatRule.MaxSelectableDay(EditYearlyMonth); i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
            @if (EditYearlyMonth == 2 && EditYearlyDay == 29)
            {
                <div class="tep-hint">@Constants.Repeat.Feb29LeapHint</div>
            }
        }
        else
        {
            <div class="tep-row">
                <label class="tep-label">Week</label>
                <select class="tep-select" aria-label="Week of month" @bind="EditWeekOfMonth">
                    @for (var i = 1; i <= Constants.Repeat.WeekOfMonthLabels.Length; i++)
                    {
                        <option value="@i">@Constants.Repeat.WeekOfMonthLabels[i - 1]</option>
                    }
                </select>
            </div>
            <div class="tep-row tep-weekdays">
                <label class="tep-label">Days</label>
                <div class="tep-weekday-btns">
                    @foreach (var day in WeekdayOptions)
                    {
                        var isSelected = EditWeekdays.Contains(day);
                        <button type="button"
                                class="tep-weekday-btn @(isSelected ? "active" : "")"
                                @onclick="() => ToggleWeekday(day)">
                            @day.ToString().Substring(0, 2)
                        </button>
                    }
                </div>
            </div>
        }
    }

    <div class="tep-row">
        <label class="tep-label">Schedule</label>
        <input type="date" class="tep-input" @bind="EditScheduledDate" @bind:event="onchange" aria-label="Schedule date" />
    </div>

    @if (ShowPause)
    {
        <div class="tep-row">
            <label class="tep-label">Pause</label>
            <button type="button" class="tep-toggle @(EditIsPaused ? "active" : "")" @onclick="TogglePause">
                @Constants.Repeat.PausedIcon
                <span class="tep-toggle-label">@(EditIsPaused ? "Paused" : "Not paused")</span>
            </button>
        </div>
    }

    @if (!IsSubtask)
    {
        <div class="tep-row">
            <label class="tep-label">List</label>
            <select class="tep-select" @bind="EditListId" @bind:event="onchange" aria-label="Task list">
                <option value="@Constants.TaskLists.LocalPomodoroListId">Pomodoro</option>
                @if (GoogleLists.Any())
                {
                    <option value="" disabled>- Google Tasks -</option>
                    @foreach (var list in GoogleLists)
                    {
                        <option value="@list.Id">@list.Title</option>
                    }
                }
            </select>
        </div>
    }

    <div class="tep-actions">
        <button class="tep-save-btn" @onclick="HandleSave">Save</button>
        <button class="tep-cancel-btn" @onclick="HandleCancel">Cancel</button>
    </div>
</div>
