@inherits TaskListBase
@using Pomodoro.Web.Models

<div class="task-card">
    <div class="task-items">
        @foreach (var node in ActiveTaskNodes)
        {
            <TaskItemComponent @key="node.Task.Id"
                Item="node.Task"
                Depth="node.Depth"
                HasChildren="node.HasChildren"
                ChildCount="node.ChildCount"
                Siblings="SiblingsFor(node.Task)"
                IsCollapsed="_collapsed.Contains(node.Task.Id)"
                IsSelected="node.Task.Id == CurrentTaskId"
                IsReorderable="IsReorderableFor(node.Task)"
                IsDragActive="_isDragging"
                DraggedTaskId="_draggedTaskId"
                ReorderGroup="OrderedGroupFor(node.Task)"
                             IsNewlyAdded="HighlightTaskId == node.Task.Id"
                             GoogleListTitle="@GoogleListTitleFor(node.Task)"
                             GoogleLists="GoogleLists"
                             OnSelect="HandleTaskSelect"
                OnComplete="HandleTaskComplete"
                OnDelete="HandleTaskDelete"
                OnUncomplete="HandleTaskUncomplete"
                OnEdit="HandleTaskEdit"
                OnAddSubtask="HandleAddSubtask"
                OnReparentToRoot="HandleReparentToRoot"
                OnDemote="HandleDemote"
                OnToggleFollowParent="HandleToggleFollowParent"
                OnToggleCollapse="ToggleCollapse"
                OnReorder="HandleTaskReorder"
                OnDragStarted="HandleDragStarted"
                OnDragEnded="HandleDragEnded" />
        }

        @if (HasCompletedTasks)
        {
            <div class="completed-section">
                <button class="completed-toggle" @onclick="ToggleCompletedExpanded" aria-label="@(_isCompletedExpanded ? "Collapse completed" : "Expand completed")" aria-expanded="@_isCompletedExpanded.ToString().ToLowerInvariant()">
                    <svg class="completed-caret @(_isCompletedExpanded ? "" : "collapsed")" width="12" height="12" viewBox="0 0 12 12"><path d="M3 1.5l4 4.5-4 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="completed-label">Completed</span>
                    <span class="completed-count">@CompletedTaskNodes.Count</span>
                </button>
                @if (_isCompletedExpanded)
                {
                    @foreach (var node in CompletedTaskNodes)
                    {
                        <TaskItemComponent @key="node.Task.Id"
                            Item="node.Task"
                            Depth="node.Depth"
                            HasChildren="node.HasChildren"
                            ChildCount="node.ChildCount"
                            Siblings="SiblingsFor(node.Task)"
                            IsCollapsed="_collapsed.Contains(node.Task.Id)"
                            IsSelected="false"
                            IsReorderable="IsReorderableFor(node.Task)"
                            IsDragActive="_isDragging"
                            DraggedTaskId="_draggedTaskId"
                            ReorderGroup="OrderedGroupFor(node.Task)"
                            IsNewlyAdded="HighlightTaskId == node.Task.Id"
                GoogleListTitle="@GoogleListTitleFor(node.Task)"
                GoogleLists="GoogleLists"
                            OnSelect="HandleTaskSelect"
                            OnComplete="HandleTaskComplete"
                            OnDelete="HandleTaskDelete"
                            OnUncomplete="HandleTaskUncomplete"
                            OnEdit="HandleTaskEdit"
                            OnAddSubtask="HandleAddSubtask"
                            OnReparentToRoot="HandleReparentToRoot"
                            OnDemote="HandleDemote"
                            OnToggleFollowParent="HandleToggleFollowParent"
                            OnToggleCollapse="ToggleCollapse"
                            OnReorder="HandleTaskReorder"
                            OnDragStarted="HandleDragStarted"
                            OnDragEnded="HandleDragEnded" />
                    }
                }
            </div>
        }
    </div>

    <div class="add-task-section">
        @if (_isMoreExpanded)
        {
            <div class="task-edit-panel">
                <div class="tep-header">
                    <span class="tep-title">DETAILS</span>
                    <button class="tep-collapse" @onclick="ToggleMore" aria-label="Hide options" aria-expanded="true">
                        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2 7.5l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="tep-row">
                    <label class="tep-label">Name</label>
                    <textarea class="tep-input tep-input-name" rows="1" @bind="NewTaskName" @bind:event="oninput" @onkeydown="HandleKeyPress" placeholder="Add a task..." aria-label="New task name"></textarea>
                </div>
                <div class="tep-row">
                    <label class="tep-label">List</label>
                    <select class="tep-select" @bind="_newTaskListId" @bind:event="onchange">
                        <option value="@Constants.TaskLists.LocalPomodoroListId">Pomodoro</option>
                        @if (GoogleLists.Any())
                        {
                            <option value="" disabled>— Google Tasks —</option>
                            @foreach (var list in GoogleLists)
                            {
                                <option value="@list.Id">@list.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="tep-row">
                    <label class="tep-label">Repeat</label>
                    <select class="tep-select" @bind="_newTaskRepeatType" @bind:event="onchange">
                        <option value="@RepeatType.None">None</option>
                        <option value="@RepeatType.Daily">Daily</option>
                        <option value="@RepeatType.Weekly">Weekly</option>
                        <option value="@RepeatType.Custom">Every N days</option>
                        <option value="@RepeatType.Monthly">Monthly</option>
                        <option value="@RepeatType.Quarterly">Quarterly</option>
                        <option value="@RepeatType.Yearly">Yearly</option>
                    </select>
                </div>
                @if (_newTaskRepeatType == RepeatType.Weekly)
                {
                    <div class="tep-row tep-weekdays">
                        <label class="tep-label">Days</label>
                        <div class="tep-weekday-btns">
                            @foreach (var day in WeekdayOptions)
                            {
                                var isSelected = _newTaskWeekdays.Contains(day);
                                var dayVal = day;
                                <button type="button"
                                        class="tep-weekday-btn @(isSelected ? "active" : "")"
                                        @onclick="() => ToggleNewWeekday(dayVal)">
                                    @day.ToString().Substring(0, 2)
                                </button>
                            }
                        </div>
                    </div>
                }
                @if (_newTaskRepeatType == RepeatType.Custom)
                {
                    <div class="tep-row">
                        <label class="tep-label">Every</label>
                        <input type="number" class="tep-input tep-input-sm" min="1" max="@Constants.Repeat.MaxCustomDays"
                               @bind="_newTaskCustomDays" @bind:event="oninput" />
                        <span class="tep-unit">days</span>
                    </div>
                }
                @if (_newTaskRepeatType == RepeatType.Monthly)
                {
                    <div class="tep-row">
                        <label class="tep-label">Day</label>
                        <input type="number" class="tep-input tep-input-sm" min="1" max="31"
                               @bind="_newTaskMonthlyDay" @bind:event="oninput" />
                        <span class="tep-unit">of month</span>
                    </div>
                }
                @if (_newTaskRepeatType == RepeatType.Quarterly)
                {
                    <div class="tep-row">
                        <label class="tep-label">Day</label>
                        <input type="number" class="tep-input tep-input-sm" min="1" max="31"
                               @bind="_newTaskQuarterlyDay" @bind:event="oninput" />
                        <span class="tep-unit">of quarter</span>
                    </div>
                }
                @if (_newTaskRepeatType == RepeatType.Yearly)
                {
                    <div class="tep-row">
                        <label class="tep-label">Day</label>
                        <input type="number" class="tep-input tep-input-sm" min="1" max="31"
                               @bind="_newTaskYearlyDay" @bind:event="oninput" />
                        <span class="tep-unit">of month</span>
                    </div>
                    <div class="tep-row">
                        <label class="tep-label">Month</label>
                        <input type="number" class="tep-input tep-input-sm" min="1" max="12"
                               @bind="_newTaskYearlyMonth" @bind:event="oninput" />
                        <span class="tep-unit">of year</span>
                    </div>
                }
                <div class="tep-row">
                    <label class="tep-label">Schedule</label>
                    <input type="date" class="tep-input" @bind="_newTaskScheduledDate" @bind:event="onchange" />
                </div>
                @if (_newTaskRepeatType != RepeatType.None)
                {
                    <div class="tep-row">
                        <label class="tep-label">Pause</label>
                        <button type="button" class="tep-toggle @(_newTaskIsPaused ? "active" : "")" @onclick="() => _newTaskIsPaused = !_newTaskIsPaused">
                            @Constants.Repeat.PausedIcon
                            <span class="tep-toggle-label">@(_newTaskIsPaused ? "Paused" : "Not paused")</span>
                        </button>
                    </div>
                }
                <div class="tep-actions">
                    <button class="tep-save-btn" @onclick="HandleAddTask" disabled="@IsAddDisabled">Create</button>
                    <button class="tep-cancel-btn" @onclick="CancelMore">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="add-task-form">
                <div class="task-input-wrap">
                    <textarea rows="1"
                           @bind="NewTaskName"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyPress"
                           placeholder="Add a task..."
                           class="task-input"
                           aria-label="New task name"></textarea>
                    <span class="task-input-hint">Shift+Enter for details</span>
                </div>
                <button class="btn-more" @onclick="ToggleMore" aria-label="Show more options" aria-expanded="false">
                    <span>More</span>
                    <svg width="12" height="12" viewBox="0 0 10 10" fill="none"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="btn-add-text" @onclick="HandleAddTask" disabled="@IsAddDisabled" aria-label="Add task">
                    Add
                </button>
            </div>
        }
    </div>
</div>
