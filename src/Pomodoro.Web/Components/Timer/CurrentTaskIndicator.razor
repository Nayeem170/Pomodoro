@using Pomodoro.Web.Services.Formatters

@if (CurrentSessionType == SessionType.Pomodoro)
{
    <div class="active-task">
        <div class="task-dot"></div>
        @if (CurrentTaskId.HasValue)
        {
            var currentTask = Tasks.FirstOrDefault(t => t.Id == CurrentTaskId.Value);
            if (currentTask != null)
            {
                var segments = TaskPathFormatter.BuildSegments(Tasks, currentTask.Id);
                var aria = TaskPathFormatter.BuildAriaLabel(Tasks, currentTask.Id);
                <span class="task-path" aria-label="@aria"><TaskPath Segments="segments" /></span>
            }
        }
        else
        {
            <span style="color: var(--color-text-tertiary); font-style: italic;">@Constants.TaskUI.SelectTaskPrompt</span>
        }
    </div>
}

@code {
    [Parameter]
    public SessionType CurrentSessionType { get; set; }

    [Parameter]
    public Guid? CurrentTaskId { get; set; }

    [Parameter]
    public List<TaskItem> Tasks { get; set; } = new();
}
