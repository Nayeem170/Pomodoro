@inherits TimerDisplayBase

<div class="ring-area">
    <svg width="200" height="200" viewBox="0 0 200 200">
        <circle class="ring-bg" cx="100" cy="100" r="90"/>
        <circle class="ring-fill @GetRingSessionClass()" cx="100" cy="100" r="90"
                style="stroke-dasharray: @((int)(2 * Math.PI * 90)); stroke-dashoffset: @GetDashOffset()"/>
    </svg>
    <div class="timer-center">
        <div class="timer-time">
            @FormatTime(CurrentRemainingTime)
        </div>
        <div class="timer-mode-label">
            @GetSessionTypeLabel()
        </div>
    </div>
</div>
