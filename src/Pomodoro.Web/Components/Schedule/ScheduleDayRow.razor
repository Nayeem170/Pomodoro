@using Pomodoro.Web.Models
@using Pomodoro.Web.Components.Tasks

<div class="sched-day">
    <div class="day-header" aria-label="@Day.DayLabel">@Day.DayLabel</div>
    <ul class="day-items" role="list">
        @if (Day.Items.Count == 0)
        {
            <li class="day-empty">No tasks scheduled</li>
        }
        else
        {
            @foreach (var item in Day.Items)
            {
                var taskId = item.Task?.Id;
                var googleTaskId = item.Task?.GoogleTaskId;
                var children = !taskId.HasValue ? [] :
                    _allSubtasks.Where(s =>
                        s.ParentTaskId == taskId.Value ||
                        (!string.IsNullOrEmpty(googleTaskId) && s.GoogleParentTaskId == googleTaskId)).ToList();
                var hasChildren = children.Count > 0;
                <li class="day-item-wrap">
                    @if (item.Task is not null)
                    {
                        <TaskItemComponent Item="item.Task"
                                           Depth="0"
                                           HasChildren="hasChildren"
                                           IsCollapsed="_collapsedIds.Contains(item.Task.Id)"
                                           IsSelected="false"
                                           GoogleListTitle="@GoogleListTitleFor(item.Task)"
                                           OnSelect="HandleSelect"
                                           OnComplete="OnComplete"
                                           OnDelete="OnDelete"
                                           OnUncomplete="OnUncomplete"
                                           OnEdit="OnEditTask"
                                           OnAddSubtask="OnAddSubtask"
                                           OnReparentToRoot="OnReparentToRoot"
                                           OnToggleCollapse="ToggleCollapse" />
                    }
                    else
                    {
                        <div class="day-item @(item.IsCompleted ? "done" : "")">
                            <span class="item-title">@item.Title</span>
                        </div>
                    }
                    @if (hasChildren && !_collapsedIds.Contains(taskId!.Value))
                    {
                        @foreach (var child in children)
                        {
                            <TaskItemComponent Item="child"
                                               Depth="1"
                                               HasChildren="false"
                                               IsCollapsed="false"
                                               IsSelected="false"
                                               GoogleListTitle="@GoogleListTitleFor(child)"
                                               OnSelect="HandleSelect"
                                               OnComplete="OnComplete"
                                               OnDelete="OnDelete"
                                               OnUncomplete="OnUncomplete"
                                               OnEdit="OnEditTask"
                                               OnAddSubtask="OnAddSubtask"
                                               OnReparentToRoot="OnReparentToRoot"
                                               OnToggleCollapse="ToggleCollapse" />
                        }
                    }
                </li>
            }
        }
    </ul>
</div>

@code {
    [Microsoft.AspNetCore.Components.Parameter]
    public ScheduleDay Day { get; set; } = default!;

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<TaskItem> OnEditTask { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<AddSubtaskRequest> OnAddSubtask { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<Guid> OnComplete { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<Guid> OnDelete { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<Guid> OnUncomplete { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<Guid> OnReparentToRoot { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public IReadOnlyList<TaskItem>? AllTasks { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Microsoft.AspNetCore.Components.EventCallback<Guid> OnSelect { get; set; }

    private readonly HashSet<Guid> _collapsedIds = new();
    private IReadOnlyList<TaskItem> _allSubtasks = [];
    private Dictionary<string, Guid> _googleIdToLocalId = new();
    private IReadOnlyList<TaskListRef> _googleLists = [];

    protected override void OnParametersSet()
    {
        var all = AllTasks ?? [];
        _googleIdToLocalId = all
            .Where(t => !string.IsNullOrEmpty(t.GoogleTaskId))
            .ToDictionary(t => t.GoogleTaskId!, t => t.Id);
        _allSubtasks = all.Where(t => t.IsSubtask && !t.IsDeleted).ToList();
    }

    private string? GoogleListTitleFor(TaskItem task) =>
        string.IsNullOrEmpty(task.GoogleListId) ? null : null;

    private async Task HandleSelect(Guid taskId)
    {
        await OnSelect.InvokeAsync(taskId);
    }

    private void ToggleCollapse(Guid taskId)
    {
        if (!_collapsedIds.Add(taskId))
            _collapsedIds.Remove(taskId);
    }
}
